# Скопируйте в .env и заполните. .env уже в .gitignore.
# Все ключи из config.example.json можно задавать и здесь — env перекрывает JSON.

# --- обязательное ---
RPC_HTTP_URL=https://rpc.ankr.com/solana/<YOUR_KEY>
RPC_WS_URL=wss://rpc.ankr.com/solana/ws/<YOUR_KEY>
TARGET_WALLET=<WALLET_ADDRESS>

# --- стратегия ---
# Покупки цели дешевле MIN_BUY_USD не копируем
MIN_BUY_USD=50
# Наш виртуальный размер входа, не зависит от размера цели
POSITION_SIZE_SOL=0.5
# Период поллинга getSignaturesForAddress (страховка на случай, если WS молчит)
POLL_INTERVAL_SEC=5
# false запускаться откажется: живой executor не реализован
DEMO_MODE=true
# true = вывод токена на другой кошелёк считать продажей
TREAT_TRANSFER_AS_SELL=false

# --- необязательное ---
# Без ключа Jupiter отдаёт ~0.5 запроса в секунду
JUPITER_API_KEY=
# DEBUG показывает и транзакции, которые бот проигнорировал
LOG_LEVEL=INFO
# Сколько прошлых транзакций разобрать на старте. 0 = начать с чистого листа
STARTUP_BACKFILL_LIMIT=0
