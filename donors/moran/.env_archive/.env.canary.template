# ==========================================
# SNIPERBOT LIVE CANARY MODE - ENV TEMPLATE
# ==========================================
# 
# SAFETY WARNING:
# This configuration enables REAL trading with REAL funds.
# Review ALL settings before enabling.
#
# To enable live canary mode:
# 1. Copy this file to .env (or merge with existing)
# 2. Set SOLANA_PRIVATE_KEY to your canary wallet private key (base58)
# 3. Set EXECUTION_MODE=live
# 4. Set TRADING_ENABLED=true ONLY when ready to trade
# 5. Restart simulation_mode.py
#
# ==========================================

# ==================== EXECUTION MODE ====================
# paper = paper trading only (default, safe)
# live = live canary mode (real trades!)
EXECUTION_MODE=paper

# Master trading kill switch (must be "true" to allow ANY live entries)
# Set to "false" to block all new entries while allowing exits
TRADING_ENABLED=false

# Required acknowledgment for live mode
ALLOW_LIVE_TRADING=YES_I_UNDERSTAND_LIVE_RISK

# ==================== WALLET ====================
# Your canary wallet private key (base58 encoded)
# DO NOT commit this to git!
# DO NOT share this with anyone!
SOLANA_PRIVATE_KEY=

# Legacy env var (also checked if SOLANA_PRIVATE_KEY empty)
PRIVATE_KEY=

# ==================== CANARY RISK LIMITS ====================
# Fixed trade size in USD (recommended: $5 for canary)
CANARY_TRADE_SIZE_USD=5.0

# Maximum concurrent open positions
CANARY_MAX_CONCURRENT=2

# Maximum daily loss before blocking new entries
CANARY_MAX_DAILY_LOSS_USD=25.0

# Failsafe stop loss percentage (0.50 = 50% loss triggers immediate exit)
CANARY_FAILSAFE_STOP_PCT=0.50

# ==================== RPC / WS ENDPOINTS ====================
# Use high-quality RPC for live trading
RPC_URL=https://solana-rpc.publicnode.com
RPC_URLS=https://solana-rpc.publicnode.com

WS_URLS=wss://api.mainnet-beta.solana.com,wss://solana-rpc.publicnode.com

# ==================== JITO BUNDLE CONFIG ====================
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TIP_LAMPORTS=20000
JITO_REGION=ny

# ==================== EXISTING CONFIG ====================
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
RAYDIUM_AUTHORITY=5Q544fKrFoe6tsEbJkQ9v9fQ6be8M8iXvP8bFzR1XkR
RUGCHECK_API_BASE=https://api.rugcheck.xyz/v1
SOLSNIFFER_API_BASE=https://api.solsniffer.com/v1
WS_PING_INTERVAL_SECONDS=45
WS_PING_TIMEOUT_SECONDS=45
MIN_LIQUIDITY_USD=2000

# ==================== STOP LOSS ====================
DEFAULT_DOWNSIDE_STOP_PCT=0.30
ABSOLUTE_FAILSAFE_STOP_PCT=0.50
