<UserControl x:Class="PumpCopy.App.Views.WalletView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <CheckBox x:Name="ShowKeysCheck" Content="show keys" VerticalAlignment="Center" Checked="OnShowKeysChanged" Unchecked="OnShowKeysChanged"/>
            <Button Content="import .txt" Margin="28,0,0,0" Padding="10,4" VerticalAlignment="Center" Click="OnImportClick"/>
            <Button Content="add key" Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center" Click="OnAddClick"/>
            <Button Content="remove" Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center" Click="OnRemoveClick"/>
            <Button Content="refresh balances" Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center" Click="OnRefreshClick"/>
            <Button x:Name="SellAllButton" Content="sell all" Margin="8,0,0,0" Padding="10,4" VerticalAlignment="Center" Click="OnSellAllClick"/>
        </StackPanel>

        <DataGrid x:Name="WalletGrid" Grid.Row="1" ItemsSource="{Binding}" Margin="0,6,0,0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="trade" Width="44">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="trader" IsChecked="{Binding IsTrading, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="wallet address" Binding="{Binding PubKey}" Width="*"/>
                <DataGridTextColumn Header="private key" Binding="{Binding KeyDisplay}" Width="150"/>
                <DataGridTextColumn Header="balance" Binding="{Binding Balance}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="SavedHint" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="save" Style="{StaticResource AccentButton}" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</UserControl>
