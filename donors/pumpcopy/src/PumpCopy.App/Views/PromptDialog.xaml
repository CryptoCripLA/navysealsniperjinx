<Window x:Class="PumpCopy.App.Views.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="200" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource Bg}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="LabelText" Style="{StaticResource MutedText}" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" Grid.Row="1" VerticalAlignment="Stretch" TextWrapping="Wrap"
                 AcceptsReturn="True" FontFamily="{StaticResource MonoFont}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="ok" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOkClick"/>
            <Button Content="cancel" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
