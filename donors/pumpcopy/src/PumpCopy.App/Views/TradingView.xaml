<UserControl x:Class="PumpCopy.App.Views.TradingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource PanelBox}" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Trading" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <CheckBox x:Name="PaperCheck" Content="paper mode (simulate fills, no keys needed)" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="size mode" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="SizeModeCombo" Margin="0,4,0,0">
                                    <ComboBoxItem Content="fixed SOL"/>
                                    <ComboBoxItem Content="follow leader"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="priority fee" Style="{StaticResource MutedText}"/>
                                <ComboBox x:Name="FeeCombo" Margin="0,4,0,0">
                                    <ComboBoxItem Content="low (50k)"/>
                                    <ComboBoxItem Content="normal (100k)"/>
                                    <ComboBoxItem Content="high (500k)"/>
                                    <ComboBoxItem Content="turbo (1M)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="fixed SOL" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="FixedSolBox" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock Text="multiplier" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="MultBox" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="max our SOL" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="MaxOurSolBox" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="SlippageLabel" Text="slippage: 5%" Style="{StaticResource MutedText}"/>
                        <Slider x:Name="SlippageSlider" Minimum="0" Maximum="30" Value="5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                ValueChanged="OnSlippageChanged" Margin="0,2,0,8"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="max positions" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="MaxPosBox" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                <TextBlock Text="min leader SOL" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="MinLeaderBox" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                <TextBlock Text="delay ms" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="DelayBox" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="sell slippage bps (sells move fast, keep looser than buys)" Style="{StaticResource MutedText}"/>
                                <TextBox x:Name="SellSlipBox" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="CopySellsCheck" Content="copy sells" Margin="0,0,0,6"/>
                        <CheckBox x:Name="SkipMigratedCheck" Content="skip migrated curves" Margin="0,0,0,6"/>
                        <CheckBox x:Name="RepeatBuysCheck" Content="allow repeat buys into an open position (leader averaging)"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBox}" Padding="14" Margin="8,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Logging" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <CheckBox x:Name="LoggingCheck" Content="write log files" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="level" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="LevelCombo" Width="90">
                                <ComboBoxItem Content="dbg"/>
                                <ComboBoxItem Content="info"/>
                                <ComboBoxItem Content="warn"/>
                                <ComboBoxItem Content="err"/>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="DemoFeedCheck" Content="demo feed (synthetic leader activity, paper only)"/>
                        <CheckBox x:Name="VerboseCheck" Content="verbose debug logs (everything: quotes, tx build, polls)" Margin="0,8,0,0" Checked="OnVerboseChanged" Unchecked="OnVerboseChanged"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="SavedHint" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="reload" Padding="14,6" Click="OnReloadClick" Margin="0,0,8,0"/>
            <Button Content="save" Style="{StaticResource AccentButton}" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</UserControl>
