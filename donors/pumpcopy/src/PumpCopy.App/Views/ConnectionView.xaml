<UserControl x:Class="PumpCopy.App.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- rpc -->
        <Border Style="{StaticResource PanelBox}" Margin="0,0,0,8">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="RPC endpoints (top = primary, others failover)" Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="add" Margin="18,0,0,0" Padding="10,3" VerticalAlignment="Center" Click="OnAddRpcClick"/>
                    <Button Content="remove" Margin="8,0,0,0" Padding="10,3" VerticalAlignment="Center" Click="OnRemoveRpcClick"/>
                    <Button Content="check all" Margin="8,0,0,0" Padding="10,3" VerticalAlignment="Center" Click="OnCheckRpcClick"/>
                    <Button Content="import list" Margin="8,0,0,0" Padding="10,3" VerticalAlignment="Center" Click="OnImportRpcClick"/>
                </StackPanel>
                <DataGrid x:Name="RpcGrid" Grid.Row="1" ItemsSource="{Binding}" Margin="0,4,0,0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="primary" Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="rpc" IsChecked="{Binding IsPrimary, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="url" Binding="{Binding Url}" Width="*"/>
                        <DataGridTextColumn Header="status" Binding="{Binding Status}" Width="180"/>
                        <DataGridTextColumn Header="ms" Binding="{Binding Ms}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- proxy -->
        <Border Grid.Row="1" Style="{StaticResource PanelBox}" Margin="0,0,0,8">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Proxy" Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox x:Name="UseProxyCheck" Content="use proxy" Margin="18,0,0,0" VerticalAlignment="Center"/>
                    <Button Content="add" Margin="18,0,0,0" Padding="10,3" VerticalAlignment="Center" Click="OnAddProxyClick"/>
                    <Button Content="remove" Margin="8,0,0,0" Padding="10,3" VerticalAlignment="Center" Click="OnRemoveProxyClick"/>
                    <Button Content="check" Margin="8,0,0,0" Padding="10,3" VerticalAlignment="Center" Click="OnCheckProxyClick"/>
                    <Button Content="import list" Margin="8,0,0,0" Padding="10,3" VerticalAlignment="Center" Click="OnImportProxyClick"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="socks5 only, one per line: socks5://host:port or socks5://user:pass@host:port" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <DataGrid x:Name="ProxyGrid" Grid.Row="2" ItemsSource="{Binding}" Margin="0,4,0,0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="active" Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <RadioButton GroupName="proxy" IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="proxy" Binding="{Binding Url}" Width="*"/>
                        <DataGridTextColumn Header="status" Binding="{Binding Status}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock x:Name="SavedHint" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Content="save" Style="{StaticResource AccentButton}" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</UserControl>
