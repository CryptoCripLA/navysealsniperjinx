<Window x:Class="PumpCopy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PumpCopy — pump.fun copy trade bot"
        Width="1150" Height="720" MinWidth="900" MinHeight="600"
        Background="{StaticResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PumpCopy" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionText" Text="v0.1.0" Style="{StaticResource MutedText}" Margin="8,0,0,2" VerticalAlignment="Center"/>
                    <Border x:Name="ModeBadge" Margin="16,0,0,0" Padding="8,2" CornerRadius="3" Background="{StaticResource AccentDark}" VerticalAlignment="Center">
                        <TextBlock x:Name="ModeBadgeText" Text="PAPER" Foreground="#04100C" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Red}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="stopped" Style="{StaticResource MutedText}" Margin="8,0,16,0" VerticalAlignment="Center"/>
                    <Button x:Name="StartButton" Content="START" Style="{StaticResource AccentButton}" Click="OnStartClick" Width="90"/>
                    <Button x:Name="StopButton" Content="STOP" Click="OnStopClick" Width="90" Margin="8,0,0,0" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- tabs -->
        <TabControl Grid.Row="1">
            <TabItem Header="Main">
                <ContentControl x:Name="MainHost"/>
            </TabItem>
            <TabItem Header="Wallet">
                <ContentControl x:Name="WalletHost"/>
            </TabItem>
            <TabItem Header="Connection">
                <ContentControl x:Name="ConnectionHost"/>
            </TabItem>
            <TabItem Header="Trading">
                <ContentControl x:Name="TradingHost"/>
            </TabItem>
        </TabControl>

        <!-- log -->
        <Border Grid.Row="2" Margin="10,6,10,4" Style="{StaticResource PanelBox}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,0">
                    <TextBlock Text="Log" Foreground="{StaticResource Accent}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <CheckBox x:Name="AutoscrollCheck" Content="autoscroll" IsChecked="True" Margin="18,0,0,0" VerticalAlignment="Center"/>
                    <Button x:Name="ClearLogButton" Content="clear" Padding="8,2" Margin="18,0,0,0" VerticalAlignment="Center" Click="OnClearLogClick"/>
                </StackPanel>
                <ListView x:Name="LogView" Grid.Row="1" Margin="6,0,6,6" BorderThickness="0"
                          FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                          ScrollViewer.CanContentScroll="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Line}" Foreground="{Binding Brush}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- status bar -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="12,0">
                <TextBlock x:Name="RpcStatusText" Text="rpc: -" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <TextBlock x:Name="WsStatusText" Text="ws: -" Style="{StaticResource MutedText}" Margin="24,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="PositionsText" Text="positions: 0" Style="{StaticResource MutedText}" Margin="24,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="PnlText" Text="session pnl: 0.0000 SOL" Style="{StaticResource MutedText}" Margin="24,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
